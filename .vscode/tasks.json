{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compiler Watch",
      "type": "process",
      "command": "powershell.exe",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": [],
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "arrow-up"
      },
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "$ErrorActionPreference = 'Stop'; if (Get-Command regolith -ErrorAction SilentlyContinue) { regolith watch } elseif (Get-Command dash_compiler -ErrorAction SilentlyContinue) { dash_compiler watch } else { [Console]::Error.WriteLine('Compiler not found: install Regolith or dash_compiler and add it to PATH.'); exit 127 }; exit $LASTEXITCODE"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Atelier: Audit Content",
      "type": "npm",
      "script": "content:audit",
      "problemMatcher": []
    },
    {
      "label": "Atelier: Review Variants",
      "type": "npm",
      "script": "variants:audit",
      "problemMatcher": []
    },
    {
      "label": "Atelier: Preview Stone Overhaul",
      "type": "npm",
      "script": "content:overhaul",
      "problemMatcher": []
    },
    {
      "label": "Atelier: Check Reviewed Decisions",
      "type": "shell",
      "command": "npm run content:check -- --require-decisions",
      "problemMatcher": []
    }
  ]
}
