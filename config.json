{
	"type": "minecraftBedrock",
	"name": "Dorios' Atelier",
	"namespace": "utilitycraft",
	"authors": [
		"Dorios Studios"
	],
	"targetVersion": "1.26.10",
	"description": "1.1.0 §6Dorios Studios§8",
	"experimentalGameplay": {
		"upcomingCreatorFeatures": false,
		"experimentalCreatorCameraFeatures": false,
		"enableGameTestFramework": false,
		"renderDragonFeatures": false,
		"educationEdition": false
	},
	"bdsProject": false,
	"packs": {
		"behaviorPack": "./BP",
		"resourcePack": "./RP"
	},
	"worlds": [
		"./worlds/*"
	],
	"compiler": {
		"plugins": [
			"generatorScripts",
			"typeScript",
			"entityIdentifierAlias",
			"customEntityComponents",
			"customItemComponents",
			"customBlockComponents",
			"customCommands",
			"moLang",
			"formatVersionCorrection",
			[
				"simpleRewrite",
				{
					"packName": "Dorios' Atelier"
				}
			],
			"textureList"
		]
	},
	"author": "Dorios Studios",
	"regolith": {
		"formatVersion": "1.8.0",
		"dataPath": "./data",
		"filterDefinitions": {
			"texture_list": {
				"runWith": "shell",
				"command": "node -e \"const fs=require('node:fs'),path=require('node:path');const dir='RP/textures';const textures=fs.readdirSync(dir,{recursive:true}).filter(file=>['.png','.tga'].includes(path.extname(file).toLowerCase())&&fs.statSync(path.join(dir,file)).isFile()).map(file=>'textures/'+file.split(path.sep).join('/').slice(0,-path.extname(file).length)).sort();fs.writeFileSync(path.join(dir,'textures_list.json'),JSON.stringify(textures,null,2));\""
			}
		},
		"profiles": {
			"default": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "texture_list"
					}
				]
			}
		}
	}
}
