{
	"type": "minecraftBedrock",
	"name": "Dorios' Atelier",
	"namespace": "utilitycraft",
	"authors": [
		"Dorios Studios"
	],
	"targetVersion": "1.26.40",
	"description": "1.1.0 Beta 4 | Pack 1.0.04 §6Dorios Studios§8",
	"experimentalGameplay": {
		"upcomingCreatorFeatures": false,
		"experimentalCreatorCameraFeatures": false,
		"enableGameTestFramework": false,
		"renderDragonFeatures": false,
		"educationEdition": false
	},
	"bdsProject": false,
	"packs": {
		"behaviorPack": "./BP",
		"resourcePack": "./RP"
	},
	"worlds": [
		"./worlds/*"
	],
	"compiler": {
		"plugins": [
			"generatorScripts",
			"typeScript",
			"entityIdentifierAlias",
			"customEntityComponents",
			"customItemComponents",
			"customBlockComponents",
			"customCommands",
			"moLang",
			"formatVersionCorrection",
			[
				"simpleRewrite",
				{
					"packName": "Dorios' Atelier"
				}
			],
			"textureList"
		]
	},
	"author": "Dorios Studios",
	"regolith": {
		"formatVersion": "1.8.0",
		"dataPath": "./data",
		"filterDefinitions": {
			"texture_list": {
				"runWith": "shell",
				"command": "node -e \"const fs=require('node:fs'),path=require('node:path');const dir='RP/textures';const textures=fs.readdirSync(dir,{recursive:true}).filter(file=>['.png','.tga'].includes(path.extname(file).toLowerCase())&&fs.statSync(path.join(dir,file)).isFile()).map(file=>'textures/'+file.split(path.sep).join('/').slice(0,-path.extname(file).length)).sort();fs.writeFileSync(path.join(dir,'textures_list.json'),JSON.stringify(textures,null,2));\""
			},
			"minify_bundle_scripts": {
				"runWith": "shell",
				"command": "npx --no-install esbuild ./BP/scripts/main.js --outfile=BP/scripts/__bundle.js --bundle --format=esm --target=es2020 --minify --legal-comments=none --log-level=warning --external:@minecraft/server --external:@minecraft/server-ui --external:@minecraft/server-* --external:@minecraft/common --external:@minecraft/debug-utilities --preserve-symlinks"
			},
			"use_bundle_entry": {
				"runWith": "shell",
				"command": "node -e \"const fs=require('fs'); const p='BP/manifest.json'; const m=JSON.parse(fs.readFileSync(p,'utf8')); const script=m.modules.find(module=>module.type==='script'); if(script) script.entry='scripts/__bundle.js'; fs.writeFileSync(p, JSON.stringify(m,null,'\\t'));\""
			},
			"cleanup_bundled_scripts": {
				"runWith": "shell",
				"command": "node -e \"const fs=require('fs'); fs.renameSync('BP/scripts/__bundle.js','BP/__bundle.js'); fs.rmSync('BP/scripts',{recursive:true,force:true}); fs.mkdirSync('BP/scripts',{recursive:true}); fs.renameSync('BP/__bundle.js','BP/scripts/__bundle.js');\""
			},
			"minify_json": {
				"runWith": "shell",
				"command": "node data/minify-json.mjs"
			}
		},
		"profiles": {
			"default": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "texture_list"
					}
				]
			},
			"buildDev": {
				"export": {
					"bpName": "project.name + ' BP'",
					"rpName": "project.name + ' RP'",
					"target": "local"
				},
				"filters": [
					{
						"filter": "texture_list"
					}
				]
			},
			"buildMinify": {
				"export": {
					"bpName": "project.name + ' BP'",
					"rpName": "project.name + ' RP'",
					"target": "local"
				},
				"filters": [
					{
						"filter": "texture_list"
					},
					{
						"filter": "minify_bundle_scripts"
					},
					{
						"filter": "use_bundle_entry"
					},
					{
						"filter": "cleanup_bundled_scripts"
					},
					{
						"filter": "minify_json"
					}
				]
			}
		}
	}
}
